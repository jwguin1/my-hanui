# YouTube Data API v3 key — used by src/lib/youtube.ts
# 발급: https://console.cloud.google.com/apis/credentials
# 1) Google Cloud Console → 새 프로젝트 생성
# 2) "APIs & Services" → "Library" → "YouTube Data API v3" 검색 → Enable
# 3) "APIs & Services" → "Credentials" → "Create Credentials" → "API key"
# 4) 발급된 키를 아래에 붙여넣고 파일명을 .env.local 로 저장
YOUTUBE_API_KEY=

# NAVER Cloud Console > Maps > Application > Dynamic Map
# Client ID only (public browser identifier); never put Client Secret here.
# Register https://www.ilsanhan.com and https://ilsanhan.com as Web service URLs.
# Set the same variable in Vercel Production, then rebuild/redeploy.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
